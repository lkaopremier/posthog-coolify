# Copier ce fichier en .env et remplir les valeurs
# Pour Coolify : configurer ces variables dans l'interface, ne pas committer .env

# ── Obligatoires ──────────────────────────────────────────────────────────────

# Domaine public (sans https://)
DOMAIN=posthog.exemple.com

# Clé secrète Django — générer avec : openssl rand -hex 28
POSTHOG_SECRET=

# Clé de chiffrement — générer avec : openssl rand -hex 16
ENCRYPTION_SALT_KEYS=

# ── Optionnels ────────────────────────────────────────────────────────────────

# Tag de l'image PostHog (défaut: latest)
# Voir les tags disponibles : https://hub.docker.com/r/posthog/posthog/tags
POSTHOG_APP_TAG=latest

# Tag de l'image Node.js de PostHog (défaut: latest)
POSTHOG_NODE_TAG=latest

# Désactiver l'envoi de télémétrie anonyme vers PostHog
OPT_OUT_CAPTURE=false
